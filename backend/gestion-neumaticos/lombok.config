config.stopBubbling = true
# Marca el código generado con @lombok.Generated para que JaCoCo no lo cuente.
lombok.addLombokGeneratedAnnotation = true
# Las entidades @Data comparan solo por sus propios campos, no por los de auditoría
# que heredan de AuditableEntity.
lombok.equalsAndHashCode.callSuper = skip
lombok.toString.callSuper = skip
