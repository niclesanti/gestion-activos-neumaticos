# Copiar a .env (gitignored) y completar. Generar cada clave al azar, por ejemplo:
#   openssl rand -hex 24        (claves de base y pgAdmin)
#   openssl rand -base64 32     (JWT_SECRET)

# PostgreSQL. DB_USER/DB_PASSWORD son el superusuario de la imagen: solo crea el
# owner al inicializar el volumen, ningún servicio de la app los usa.
DB_NAME=gestion-neumaticos-db
DB_USER=postgres
DB_PASSWORD=

# Owner de la base (sin SUPERUSER ni BYPASSRLS): solo lo usa el job de migraciones.
DB_OWNER_USER=gn_owner
DB_OWNER_PASSWORD=

# Clave del rol de conexión de la app (gn_app, sin privilegios propios).
# Flyway la aplica en cada migrate, así que se rota cambiando solo esta variable.
DB_APP_PASSWORD=

# Ubicaciones de Flyway del job de migraciones. En dev se suma el seed de
# usuarios de prueba; en prod dejar solo la primera.
FLYWAY_LOCATIONS=filesystem:/flyway/sql/migraciones,filesystem:/flyway/sql/seed-dev

# pgAdmin (perfil "herramientas": docker compose --profile herramientas up -d pgadmin)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Perfil de Spring Boot: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Origen del frontend permitido por CORS (sin barra final).
FRONTEND_URL=http://localhost:3000

# URL de la API que el frontend incrusta al compilarse (y que su CSP permite).
VITE_API_URL=http://localhost:8080

# Clave HMAC de los JWT: base64 de al menos 32 bytes aleatorios.
JWT_SECRET=
